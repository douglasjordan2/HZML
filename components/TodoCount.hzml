<loader>
  const rows = hzml.db.query("SELECT COUNT(*) as count FROM todos")
  const count = rows[0]?.count || 0
  if (count === 0) return ""
  const label = `todo${count !== 1 ? 's' : ''}`
  return { count, label }
</loader>

<template>
  <span class="${cls || ''}">${count}${useLabel && ` ${label}`}</span>
</template>
